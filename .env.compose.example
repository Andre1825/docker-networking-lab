# Copy to .env.compose. This file is for the Compose stack only.
# Choose a non-root application user and replace both example passwords.
DB_NAME=networking_lab
DB_USER=lab_user
DB_PASS='REPLACE_WITH_A_STRONG_APP_PASSWORD'
MYSQL_ROOT_PASSWORD='REPLACE_WITH_A_DIFFERENT_STRONG_ROOT_PASSWORD'

# APP_PORT publishes Nginx; Flask replicas keep port 5000 inside Docker.
# phpMyAdmin has its own optional localhost port. MySQL is not published.
APP_PORT=5052
PHPMYADMIN_PORT=8081
